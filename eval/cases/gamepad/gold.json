    {
      "id": "input_latency",
      "name": "输入延迟",
      "description": "从物理输入动作到主机收到对应输入事件的时间。须分别注明按键或摇杆、连接方式、平台、固件和统计口径；不等同于传输延迟、回报间隔或屏幕端到端延迟。定性“零延迟”不能归一化为0。",
      "aliases": [
        "输入时延",
        "input lag"
      ],
      "type": "numeric",
      "units": [
        "毫秒"
      ],
      "formula": null,
      "direction": {
        "type": "smaller_better"
      },
      "evidence_item_ids": []
    },
    {
      "id": "report_rate",
      "name": "回报率",
      "description": "每秒向主机上报输入状态的次数。记录按键或摇杆、连接方式及名义/实测口径；厂商上限不等同有效更新率，一秒N枪不属于回报率。方向仅限相同设备模式和可比测试条件。",
      "aliases": [
        "轮询率",
        "Polling Rate"
      ],
      "type": "numeric",
      "units": [
        "Hz"
      ],
      "formula": null,
      "direction": {
        "type": "larger_better"
      },
      "evidence_item_ids": []
